# Connection the app uses (a role that is NOT the table owner, so row-level security applies)
DATABASE_URL=postgres://clinicflow_app:PASSWORD@HOST:5432/clinicflow
# Connection used only for migrations and seeding (table owner)
DATABASE_OWNER_URL=postgres://clinicflow_owner:PASSWORD@HOST:5432/clinicflow
# Long random string used to sign cookies
SESSION_SECRET=change-me
# Public URL of the app (used in links in emails and booking pages)
APP_URL=https://app.example.com
